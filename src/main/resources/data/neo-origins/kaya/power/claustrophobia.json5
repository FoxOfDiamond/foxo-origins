			type: "kaya:execute_command",
			source: {
				type: "kaya:entity",
				entity: "this"
			},
			command: "function neo-origins:claustrophobia/setup"
		}
	},
	tick_stacks: {
		type: "kaya:callback/power/tick",
		action: [
			{
				type: "kaya:execute_command",
				source: {
					type: "kaya:entity",
					entity: "this"
				},
				command: "function neo-origins:claustrophobia/tick"
			},
			{
				type: "kaya:apply_effects",
				effects: [
					{
						id: "minecraft:weakness",
						ambient: true,
						show_particles: false,
						show_icon: true
					},
					{
						id: "minecraft:slowness",
						ambient: true,
						show_particles: false,
						show_icon: true
					}
				],
				entity: "this"
			}
		],
		interval: 10
	},
	modify_duration: {
		type: "kaya:modify/effect/duration",
