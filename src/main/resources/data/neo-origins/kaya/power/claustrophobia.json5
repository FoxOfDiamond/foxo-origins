			{
				type: "kaya:set",
				phase: "total",
				amount: {
					type: "kaya:max",
					values: [
						0,
						{
							type: "kaya:product",
							values: [
								{
									type: "kaya:nbt",
									source: {
										type: "kaya:power",
										power: "*:*@storage",
										entity: "this"
									},
									path: "duration_per_stack"
								},
								{
									type: "kaya:nbt",
									source: {
										type: "kaya:power",
										power: "*:*@storage",
										entity: "this"
									},
									path: "stacks"
								}
							]
						}
					]
				}
			}
		],
		active_condition: {
			type: "kaya:check_effect_type",
			tag: "#*:*",
			effect: "applied_effect"
