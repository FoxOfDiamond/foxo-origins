{
	type: "kaya:modify/item/use",
	on_use_action: {
		type: "kaya:execute_command",
		source: {
			type: "kaya:entity",
			entity: "this"
		},
		command: "title @s actionbar {\"translate\": \"power.neo-origins.vegetarian.warning\", \"color\": \"red\", \"fallback\": \"You cannot eat meat foodstuffs!\"}"
	},
	result: "fail",
	trigger_type: "start",
	priority: 1,
	active_condition: {
		type: "kaya:all_of",
		conditions: [
			{
				type: "kaya:item_matches_predicate",
				predicate: "*[minecraft:food]",
				item: "used_item"
			},
			{
				type: "kaya:inverted",
				condition: {
					type: "kaya:item_matches_ingredient",
					ingredient: "#neo-origins:ignore_diet",
					item: "used_item"
				}
			},
			{
				type: "kaya:item_matches_ingredient",
				ingredient: "#neo-origins:meat",
				item: "used_item"
			}
		]
	}
}