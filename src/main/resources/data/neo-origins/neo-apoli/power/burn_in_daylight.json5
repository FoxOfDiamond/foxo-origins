{
	type: "neo-apoli:callback/power/tick",
	action: {
		type: "neo-apoli:set_entity_on_fire",
		ticks: 120,
		entity: "this"
	},
	interval: 20,
	active_condition: {
		type: "neo-apoli:all_of",
		conditions: [
			{
				type: "neo-apoli:reference",
				value: "*:entity/is_exposed_to_sun"
			},
			{
				type: "neo-apoli:inverted",
				condition: {
					type: "neo-apoli:is_entity_invisible",
					entity: "this"
				}
			}
		]
	}
}