{
	type: "neo-apoli:modify/item/use",
	on_use_action: {
		type: "neo-apoli:execute_command",
		source: {
			type: "neo-apoli:entity",
			entity: "this"
		},
		command: "title @s actionbar {\"translate\": \"power.neo-origins.carnivore.warning\", \"color\": \"red\", \"fallback\": \"You cannot eat non-meat foodstuffs!\"}"
	},
	result: "fail",
	trigger_type: "start",
	priority: 1,
	active_condition: {
		type: "neo-apoli:all_of",
		conditions: [
			{
				type: "neo-apoli:item_matches_predicate",
				predicate: "*[minecraft:food]",
				item: "used_item"
			},
			{
				type: "neo-apoli:inverted",
				condition: {
					type: "neo-apoli:item_matches_ingredient",
					ingredient: "#neo-origins:ignore_diet",
					item: "used_item"
				}
			},
			{
				type: "neo-apoli:inverted",
				condition: {
					type: "neo-apoli:item_matches_ingredient",
					ingredient: "#neo-origins:meat",
					item: "used_item"
				}
			}
		]
	}
}