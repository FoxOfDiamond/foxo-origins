{
	type: "neo-apoli:multiple",
	storage: {
		type: "neo-apoli:nbt"
	},
	init: {
		type: "neo-apoli:callback/power/granted",
		action: {
			type: "neo-apoli:execute_command",
			source: {
				type: "neo-apoli:entity",
				entity: "this"
			},
			command: "function neo-origins:claustrophobia/setup"
		}
	},
	tick_stacks: {
		type: "neo-apoli:callback/power/tick",
		action: [
			{
				type: "neo-apoli:execute_command",
				source: {
					type: "neo-apoli:entity",
					entity: "this"
				},
				command: "function neo-origins:claustrophobia/tick"
			},
			{
				type: "neo-apoli:apply_effects",
				effects: [
					{
						id: "minecraft:weakness",
						ambient: true,
						show_particles: false,
						show_icon: true
					},
					{
						id: "minecraft:slowness",
						ambient: true,
						show_particles: false,
						show_icon: true
					}
				],
				entity: "this"
			}
		],
		interval: 10
	},
	modify_duration: {
		type: "neo-apoli:modify/effect/duration",
		modifiers: [
			{
				type: "neo-apoli:set",
				phase: "total",
				amount: {
					type: "neo-apoli:max",
					values: [
						0,
						{
							type: "neo-apoli:product",
							values: [
								{
									type: "neo-apoli:nbt",
									source: {
										type: "neo-apoli:power",
										power: "*:*@storage",
										entity: "this"
									},
									path: "duration_per_stack"
								},
								{
									type: "neo-apoli:nbt",
									source: {
										type: "neo-apoli:power",
										power: "*:*@storage",
										entity: "this"
									},
									path: "stacks"
								}
							]
						}
					]
				}
			}
		],
		active_condition: {
			type: "neo-apoli:is_effect_in_tag",
			tag: "#*:*",
			effect: "applied_effect"
		}
	}
}