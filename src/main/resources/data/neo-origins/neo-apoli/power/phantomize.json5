{
	type: "neo-apoli:multiple",
	toggle: {
		type: "neo-apoli:toggle",
		key: "key.saveToolbarActivator",
		retain_state: false,
		active_condition: {
			type: "neo-apoli:compare",
			comparison: {
				type: "neo-apoli:int",
				comparator: ">",
				first: {
					type: "neo-apoli:player/food",
					entity: "this"
				},
				second: 6
			}
		}
	},
	on_respawn: {
		type: "neo-apoli:callback/player/respawned",
		action: {
			type: "neo-apoli:conditional",
			condition: {
				type: "neo-apoli:inverted",
				condition: {
					type: "neo-apoli:entity_has_active_power",
					power: "*:*@toggle",
					entity: "this"
				}
			},
			on_true: {
				type: "neo-apoli:toggle_power",
				power: "*:*@toggle",
				entity: "this"
			}
		}
	},
	overlay: {
		type: "neo-apoli:hud_render",
		hud_elements: [
			{
				type: "neo-apoli:overlay/nausea",
				sprite: "neo-origins:phantomize/overlay",
				color: {
					type: "neo-apoli:dynamic/argb",
					alpha: 0.75,
					red: {
						type: "neo-apoli:linear_interpolated",
						delta: {
							type: "neo-apoli:quotient",
							dividend: {
								type: "neo-apoli:from_int",
								value: {
									type: "neo-apoli:player/food",
									entity: "this"
								}
							},
							divisor: 20
						},
						start: 0.7,
						end: 0.2
					},
					green: {
						type: "neo-apoli:linear_interpolated",
						delta: {
							type: "neo-apoli:quotient",
							dividend: {
								type: "neo-apoli:from_int",
								value: {
									type: "neo-apoli:player/food",
									entity: "this"
								}
							},
							divisor: 20
						},
						start: 0.2,
						end: 0.4
					},
					blue: 0.2
				},
				render_phase: "below_hud",
				should_render: {
					type: "neo-apoli:condition_result",
					condition: {
						type: "neo-apoli:entity_has_active_power",
						power: "*:*@toggle",
						entity: "this"
					}
				}
			}
		]
	}
}