{
	type: "neo-apoli:phasing",
	render_type: "blindness",
	view_distance: 10,
	phase_down_condition: {
		type: "neo-apoli:all_of",
		conditions: [
			{
				type: "neo-apoli:is_entity_sneaking",
				entity: "this"
			},
			{
				type: "neo-apoli:is_entity_stepping_on_block",
				entity: "this"
			}
		]
	},
	active_condition: {
		type: "neo-apoli:all_of",
		conditions: [
			{
				type: "neo-apoli:entity_has_active_power",
				power: "*:phantomize@toggle",
				entity: "this"
			},
			{
				type: "neo-apoli:inverted",
				condition: {
					type: "neo-apoli:is_block_in_tag",
					tag: "#*:unphasable",
					block: "phased_block"
				}
			}
		]
	}
}