{
	type: "neo-apoli:multiple",
	prevent_eating: {
		type: "neo-apoli:modify/item/use",
		on_use_action: {
			type: "neo-apoli:execute_command",
			source: {
				type: "neo-apoli:entity",
				entity: "this"
			},
			command: "title @s actionbar {\"translate\": \"power.neo-origins.pumpkin_hate.warning\", \"color\": \"red\", \"fallback\": \"You cannot eat foodstuffs that are pumpkin-like!\"}"
		},
		result: "fail",
		trigger_type: "start",
		priority: 1,
		active_condition: {
			type: "neo-apoli:all_of",
			conditions: [
				{
					type: "neo-apoli:inverted",
					condition: {
						type: "neo-apoli:item_matches_predicate",
						predicate: "#neo-origins:pumpkin_like/food",
						item: "used_item"
					}
				},
				{
					type: "neo-apoli:item_matches_predicate",
					predicate: "*[minecraft:food]",
					item: "used_item"
				}
			]
		}
	},
	partial_visibility: {
		type: "neo-apoli:modify/model/color/other",
		color: {
			type: "neo-apoli:dynamic/argb",
			alpha: {
				type: "neo-apoli:linear_interpolated",
				delta: {
					type: "neo-apoli:quotient",
					dividend: {
						type: "neo-apoli:min",
						values: [
							{
								type: "neo-apoli:distance_between_positions",
								first: {
									type: "neo-apoli:entity/position",
									entity: "actor"
								},
								second: {
									type: "neo-apoli:entity/position",
									entity: "target"
								}
							},
							8.0
						]
					},
					divisor: 8.0
				},
				start: 1.0,
				end: 0.0
			},
			red: 1.0,
			green: 1.0,
			blue: 1.0
		},
		active_condition: {
			type: "neo-apoli:entity_has_item_equipped",
			equipped_condition: {
				type: "neo-apoli:item_matches_predicate",
				predicate: "#neo-origins:pumpkin_like/equipment",
				item: "equipped_item"
			},
			slot: "head",
			entity: "target"
		}
	}
}